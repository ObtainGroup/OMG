						<Source><![CDATA[
        /// <summary>
        /// Sorts the messages with the newest on top
        /// </summary>
        public void init()
        {
            super();

            QueryBuildDataSource qbds = this.query().dataSourceTable(tableNum(OMGInboundMessageTable));

            qbds.addSortField(fieldNum(OMGInboundMessageTable, CreatedDateTime), SortOrder::Descending);
            qbds.addSortField(fieldNum(OMGInboundMessageTable, MessageTypeId), SortOrder::Ascending);
            qbds.addSortField(fieldNum(OMGInboundMessageTable, MessageStatus), SortOrder::Ascending);
        }

]]></Source>
					</Method>
				</Methods>
				<Fields />
			</DataSource>
