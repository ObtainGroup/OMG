			<Method>
				<Name>run</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public void run()
    {
        if (azureFolderLookup.parmAzureFileShareName())
        {
            OMGAzureFolderLookup::buildFolderTree_AzureFileShare(FolderTreeControl,
                                                                 azureFolderLookup.parmKeyVaultCertificateRef(),
                                                                 azureFolderLookup.parmAzureFileShareName());
        }
        else
        {
            OMGAzureFolderLookup::buildFolderTree_AzureContainer(FolderTreeControl, azureFolderLookup.parmKeyVaultCertificateRef());
        }
        
        super();
    }

]]></Source>
