		<Methods>
			<Method>
				<Name>markMessageAsProcessed</Name>
				<Source><![CDATA[
    /// <summary>
    /// Marks a specific outbound message as processed
    /// </summary>
    /// <param name = "_messageGUID">The GUID of the message to update</param>
    [SysODataAction('markMessageAsProcessed', false)]
    public static void markMessageAsProcessed(OMGMessageGUID   _messageGUID)
    {
        OMGOutboundMessageTable     outboundMessageTable;
        ;

        ttsbegin;

        outboundMessageTable = OMGOutboundMessageTable::find(_messageGUID, true);

        if (outboundMessageTable)
        {
            outboundMessageTable.MessageStatus = OMGProcessingStatus::Processed;
            outboundMessageTable.update();
        }

        ttscommit;
    }

]]></Source>
			</Method>
		</Methods>
