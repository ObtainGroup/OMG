		<Methods>
			<Method>
				<Name>exist</Name>
				<Source><![CDATA[
    /// <summary>
    /// Checks if a metadata key exists for a given message GUID.   
    /// </summary>
    /// <param name = "_messageGUID">The message GUID</param>
    /// <param name = "_metadataKey">The metadata key</param>
    /// <returns>True if the metadata key exists for the given message GUID</returns>
    public static boolean exist(OMGMessageGUID _messageGUID,
                                 OMGMetadataKey _metadataKey)
    {
        return _messageGUID && _metadataKey &&
                    (select firstonly RecId from OMGOutboundMessageMetadata
                        where OMGOutboundMessageMetadata.MessageGUID == _messageGUID   &&
                              OMGOutboundMessageMetadata.MetadataKey == _metadataKey).RecId != 0;
    }

]]></Source>
			</Method>
			<Method>
				<Name>createMetadata</Name>
				<Source><![CDATA[
    /// <summary>
    /// Creates a new OMGOutboundMessageMetadata record if it does not already exist for the given message GUID and metadata key.
    /// </summary>
    /// <param name = "_messageGUID">The message GUID</param>
    /// <param name = "_metadataKey">The metadata key</param>
    /// <param name = "_metadataValue">The metadata value</param>
    public static void createMetadata(OMGMessageGUID    _messageGUID,
                                      OMGMetadataKey    _metadataKey,
                                      OMGMetadataValue  _metadataValue)
    {
        OMGOutboundMessageMetadata metadata;
        ;

        if (!OMGOutboundMessageMetadata::exist(_messageGUID, _metadataKey))
        {
            metadata.clear();
            metadata.initValue();
            metadata.MessageGUID    = _messageGUID;
            metadata.MetadataKey    = _metadataKey;
            metadata.MetadataValue  = _metadataValue;
            metadata.insert();
        }
    }

]]></Source>
			</Method>
		</Methods>
